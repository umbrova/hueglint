{
  "name": "@hueglint/react",
  "version": "0.0.1",
  "description": "React bindings for hueglint",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "echo \"no tests yet\"",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hueglint/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "@types/react": "^18.0.0"
  },
  "license": "MIT"
}