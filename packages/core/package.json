{
  "name": "@hueglint/core",
  "version": "1.0.1",
  "description": "Framework-agnostic accessible heatmap engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/d3-scale-chromatic": "^3.1.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
"repository": {
    "type": "git",
    "url": "https://github.com/umbrova/hueglint.git",
    "directory": "packages/core"
  },
  "homepage": "https://hueglint.umbrova.com",
  "bugs": {
    "url": "https://github.com/umbrova/hueglint/issues"
  },
  "author": "Umbrova",
  "keywords": [
    "heatmap",
    "data-visualization",
    "accessibility",
    "a11y",
    "colorblind",
    "cvd-safe",
    "viridis",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "d3-scale-chromatic": "^3.1.0"
  }
}