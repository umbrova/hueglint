---
const { siteTitle, siteTitleHref } = Astro.props;
---
<a href={siteTitleHref} class="site-title sl-flex" style="align-items: center; gap: 8px; text-decoration: none; color: inherit;">
  <img src="/hueglint-icon.svg" alt="" style="height: 28px; width: 28px;" />
  <img src="/hueglint-word.svg" alt="" class="dark:sl-hidden" style="height: 22px;" />
  <img src="/hueglint-word-dark.svg" alt="" class="light:sl-hidden" style="height: 22px;" />
  <span class="sr-only">{siteTitle}</span>
</a>