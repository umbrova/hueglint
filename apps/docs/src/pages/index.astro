---
import Playground from '../components/Playground';
import AccessibilityProof from '../components/AccessibilityProof';
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>hueglint — Clarity, not just color.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-gray-900 bg-white">
    <main class="max-w-4xl mx-auto px-6 py-12">
      <header class="mb-2">
        <h1 class="text-3xl font-medium">
          <span class="wordmark-hue">hue</span><span class="text-gray-800">glint</span>
        </h1>
      </header>

      <p class="text-gray-500 mb-8">Clarity, not just color.</p>

      <Playground client:load />

      <p class="mt-8">
        <a href="/docs/getting-started/installation/" class="text-brand-accent font-medium hover:underline">
          Get started →
        </a>
      </p>

      <AccessibilityProof client:visible />
    </main>

    <style>
      .wordmark-hue {
        background: linear-gradient(90deg, #440154, #22a884, #fde725);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
    </style>
  </body>
</html>