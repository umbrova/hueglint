---
import Playground from '../components/Playground';
import AccessibilityProof from '../components/AccessibilityProof';
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>hueglint — Clarity, not just color.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-gray-900 bg-white">
    <header class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
      <div class="flex items-center gap-2.5">
        <img src="/hueglint-icon.svg" alt="" class="h-9 w-9" />
        <img src="/hueglint-word.svg" alt="hueglint" class="h-7" />
      </div>
      <div class="flex items-center gap-4">
        <a href="/docs/" class="text-sm text-gray-600 hover:text-gray-900">Docs</a>
        <a href="/docs/getting-started/installation/" class="rounded bg-gray-900 px-4 py-1.5 text-sm text-white hover:bg-gray-800 transition">Get started</a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-10">
      <h1 class="text-5xl font-medium tracking-tight mb-3">Clarity, not just color.</h1>
      <p class="text-gray-600 max-w-md mb-6">
        CVD-safe by default, honest tooltips, native diff mode.
      </p>
      <div class="flex gap-3 mb-4">
        <a href="/docs/getting-started/installation/" class="rounded bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-800 transition">Get started</a>
        <a href="https://github.com/umbrova/hueglint/" class="rounded border border-gray-300 px-5 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-50 transition">View on GitHub</a>
      </div>
      <div class="mb-10 inline-flex items-center gap-3 rounded bg-gray-900 px-4 py-2 text-sm text-gray-100 font-mono">
        <span>npm install @hueglint/core</span>
        <button
          onclick="navigator.clipboard.writeText('npm install @hueglint/core')"
          class="text-gray-400 hover:text-white transition"
          aria-label="Copy install command"
        >
          ⧉
        </button>
      </div>

      <Playground client:load />

      <p class="text-center text-xs text-gray-500 mt-6">
        Open source · MIT licensed · React today, Vue coming in a future release
      </p>

      <AccessibilityProof client:visible />
    </main>

    <footer class="mt-16 border-t border-gray-100 py-6 text-center text-sm text-gray-500">
      <p>hueglint · MIT licensed · <a href="https://github.com/umbrova/hueglint/" class="hover:text-gray-800">GitHub</a> · <a href="/docs/getting-started/installation/" class="hover:text-gray-800">Docs</a></p>
    </footer>

    <style>
      .wordmark-hue {
        background: linear-gradient(90deg, #440154, #22a884, #fde725);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
    </style>
  </body>
</html>